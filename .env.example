# Non-secret settings; load through your process manager or export explicitly.
PROTON_PUBLIC_HOST=mail.example.com
PROTON_BRIDGE_CERT=/path/to/bridge-cert.pem
PROTON_ACTION_LOG=/path/to/private-actions/actions.jsonl
# Set both for Cloudflare Access; omit both only for trusted localhost use.
ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
ACCESS_AUD=replace-with-application-audience
# Directory containing the private two-line proton-bridge-imap credential file.
# With systemd LoadCredential, systemd supplies this automatically.
CREDENTIALS_DIRECTORY=/path/to/private-credentials
